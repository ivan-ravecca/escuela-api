# Server Configuration
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION=24h

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
ALLOWED_DOMAIN=escuelaenfermeria.com.uy

# CORS
SITE_URL=https://escuelaenfermeria.com.uy
BASE_URL=https://api.escuelaenfermeria.com.uy

# Resend Email Service
RESEND_API_KEY=re_your_resend_api_key
EMAIL_TO=contacto@escuelaenfermeria.com.uy
EMAIL_FROM=noreply@escuelaenfermeria.com.uy

# Crypto
HASH_SECRET=your_hash_secret

# Anthropic AI
ANTHROPIC_API_KEY=aKey
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_MAX_TOKENS=2048

# Database MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=anuser
DB_PASSWORD=apassword
DB_NAME=escuela

RESEND_API_KEY=aKey